# Copia este archivo a .env y rellena lo necesario.

# Proveedor del modelo: "anthropic" (por defecto) o "ollama"
LLM_PROVIDER=anthropic

# --- Si usas Claude API (Opción A) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- Si usas Ollama (local) ---
OLLAMA_MODEL=llama3.1

# --- Estrategia de contexto de la póliza ---
# "cached" = CAG con prompt caching (recomendado para 1 póliza pequeña)
# "hybrid" = RAG selecciona páginas -> carga esas páginas completas
# "rag"    = recuperación de chunks con ChromaDB (para corpus grandes)
POLICY_MODE=cached
CACHE_TTL=1h

# --- ChromaDB (solo se usa en POLICY_MODE=rag) ---
# "local" = PersistentClient en ./.chroma (sin credenciales)
# "cloud" = Chroma Cloud (gestionado)
CHROMA_MODE=local
# CHROMA_API_KEY=ck-...
# CHROMA_TENANT=...
# CHROMA_DATABASE=dev
